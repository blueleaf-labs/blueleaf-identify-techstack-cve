{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueleaf.dev/schemas/multi-source-intelligence-result.schema.json",
  "title": "Blueleaf multi-source intelligence result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "status",
    "sourceResults",
    "advisories",
    "retrievedAt",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": { "kind": { "const": "advisory-id" }, "id": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "queries"],
          "properties": {
            "kind": { "const": "package-version-batch" },
            "queries": {
              "type": "array",
              "items": { "$ref": "intelligence-result.schema.json#/$defs/query" }
            }
          }
        }
      ]
    },
    "status": {
      "enum": [
        "RESULTS",
        "NO_RESULTS",
        "PROVIDER_UNAVAILABLE",
        "PARTIAL_RESULTS",
        "INTELLIGENCE_UNAVAILABLE"
      ]
    },
    "sourceResults": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "advisories": {
      "type": "array",
      "items": { "$ref": "normalized-advisory.schema.json" }
    },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "status", "advisories", "diagnostics"],
      "properties": {
        "providerId": { "type": "string" },
        "status": {
          "enum": [
            "RESULTS",
            "NO_RESULTS",
            "PARTIAL_RESULTS",
            "PROVIDER_UNAVAILABLE",
            "UNSUPPORTED"
          ]
        },
        "advisories": {
          "type": "array",
          "items": { "$ref": "normalized-advisory.schema.json" }
        },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "sourceModifiedAt": { "type": "string", "format": "date-time" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
