{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueleaf.dev/schemas/intelligence-result.schema.json",
  "title": "Blueleaf normalized intelligence result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "providerIds",
    "queries",
    "advisories",
    "retrievedAt",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "status": {
      "enum": ["resolved", "no-advisories", "partial", "unsupported", "insufficient-data"]
    },
    "providerIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "queries": { "type": "array", "items": { "$ref": "#/$defs/query" } },
    "advisories": {
      "type": "array",
      "items": { "$ref": "normalized-advisory.schema.json" }
    },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceModifiedAt": { "type": "string", "format": "date-time" },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version"],
      "properties": {
        "ecosystem": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "affectedPackages",
        "severity",
        "references",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "affectedPackages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "ranges", "explicitVersions", "fixedVersions"],
            "properties": {
              "package": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ecosystem", "name"],
                "properties": {
                  "ecosystem": { "type": "string" },
                  "name": { "type": "string" }
                }
              },
              "ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "events"],
                  "properties": {
                    "type": { "type": "string" },
                    "repository": { "type": "string", "format": "uri" },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "introduced": { "type": "string" },
                          "fixed": { "type": "string" },
                          "lastAffected": { "type": "string" },
                          "limit": { "type": "string" }
                        },
                        "minProperties": 1,
                        "maxProperties": 1
                      }
                    }
                  }
                }
              },
              "explicitVersions": { "type": "array", "items": { "type": "string" } },
              "fixedVersions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "severity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "score"],
            "properties": { "type": { "type": "string" }, "score": { "type": "string" } }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "type": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "publishedAt": { "type": "string", "format": "date-time" },
        "modifiedAt": { "type": "string", "format": "date-time" },
        "withdrawnAt": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerId", "retrievedAt"],
          "properties": {
            "providerId": { "type": "string" },
            "recordUrl": { "type": "string", "format": "uri" },
            "retrievedAt": { "type": "string", "format": "date-time" },
            "sourceModifiedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
